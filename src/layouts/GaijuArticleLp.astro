---
/**
 * Cocoon風 記事LPテンプレート（cocoon_like_article_lp_template）ベースのレイアウト。
 * テンプレートのクラス名・構造を維持したまま、PR表記・固定CTA・計測を組み込んでいる。
 */
import CtaButton from '@/components/gaiju/article/CtaButton.astro';
import { gaijuLpConfig } from '@/data/gaiju-lp-config';
import { getProvider } from '@/data/gaiju-providers';

interface Props {
  title: string;
  description: string;
  animal: string;
  path: string;
  stickyLabel: string;
  stickyNote: string;
}
const { title, description, animal, path, stickyLabel, stickyNote } = Astro.props as Props;
const canonical = `${gaijuLpConfig.siteUrl}${path}`;
const ogImage = `${gaijuLpConfig.siteUrl}/og-default.svg`;
const links = gaijuLpConfig.footerLinks.filter((l) => l.href);
/** 開発時のみ、アフィリエイトURL未設定を警告する（本番ビルドには出力されない） */
const rank1 = getProvider('houseguard24');
const affiliateUnset = Boolean(rank1 && !rank1.affiliateUrl);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={gaijuLpConfig.siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/gaiju/article-lp.css" />
    <!--
      GA4 / Google Ads の測定IDは未提供のため埋め込んでいない。
      GTM または gtag のスニペットをここへ追加すれば dataLayer 経由でイベントを受け取れる。
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
    </script>
    <script is:inline define:vars={{ animal }}>
      window.GAIJU_LP = { animal };
    </script>
    <script is:inline defer src="/gaiju/lp.js"></script>
  </head>
  <body>
    {import.meta.env.DEV && affiliateUnset && (
      <div class="dev-banner">
        [開発表示] ハウスガード24のアフィリエイトURLが未設定です。
        src/data/gaiju-providers.ts の affiliateUrl を設定するまで本番公開しないでください。
      </div>
    )}

    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-logo" href="/gaiju/">{gaijuLpConfig.siteName}</a>
        <span class="site-header__note">PR</span>
      </div>
    </header>

    <p class="pr-bar">PR｜本ページには広告が含まれています</p>

    <slot name="fv" />

    <main class="page-shell">
      <article class="article-lp">
        <slot />

        <footer class="article-footer">
          <p>
            <strong>広告について：</strong>
            当サイトはアフィリエイト広告を利用しています。
            掲載内容は各社の公式サイト・公開情報等をもとに作成しています。
            サービス内容・料金・保証条件は変更される場合がありますので、
            お申し込み前に必ず遷移先の公式サイトで最新情報をご確認ください。
          </p>
          <ul class="footer-links">
            {links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </footer>
      </article>
    </main>

    <div class="sticky-cta">
      <div class="sticky-cta__inner">
        <p class="sticky-cta__note">{stickyNote}</p>
        <CtaButton label={stickyLabel} position="sticky" animal={animal} />
      </div>
    </div>
  </body>
</html>
