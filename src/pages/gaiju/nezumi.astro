---
/**
 * ネズミ駆除比較記事LP（PPC専用）
 * URL: /gaiju/nezumi/
 * 検索意図: 天井・壁・床下から音がして、ネズミがいるのではないかと不安。原因や侵入口を調べたい。
 * 台本: 03_LP_NEZUMI.md
 */
import GaijuLp from '@/layouts/GaijuLp.astro';
import Cta from '@/components/gaiju/Cta.astro';
import ImagePlaceholder from '@/components/gaiju/ImagePlaceholder.astro';
import SymptomChecklist from '@/components/gaiju/SymptomChecklist.astro';
import SelectionCriteria from '@/components/gaiju/SelectionCriteria.astro';
import RankingSection from '@/components/gaiju/RankingSection.astro';
import ComparisonTable from '@/components/gaiju/ComparisonTable.astro';
import ServiceFlow from '@/components/gaiju/ServiceFlow.astro';
import Faq from '@/components/gaiju/Faq.astro';
import FinalCta from '@/components/gaiju/FinalCta.astro';

const ANIMAL = 'nezumi';

const heroBullets = [
  '現地調査 0円',
  'お見積り 0円',
  '関東7県対応',
  '24時間365日受付',
  '最短30分・即日対応',
  '施工箇所の永年保証制度',
];

const symptoms = [
  '夜になると天井からカリカリ音がする',
  '壁の中からゴソゴソ音が聞こえる',
  '屋根裏で走り回るような音がする',
  '床下から物音がする',
  '食品の袋などがかじられている',
  '家の中で小さな糞を見つけた',
  '一度対策したのにまた音がする',
  'どこから入っているのかわからない',
];

const criteria = [
  '現地調査の費用',
  '見積もりの費用',
  'ネズミへの対応',
  '侵入口への対策',
  '再発対策',
  '保証',
  '対応エリア',
  '相談しやすさ・受付体制',
];

const rank1Points = [
  'ネズミ対応',
  '現地調査 0円',
  'お見積り 0円',
  '関東7県対応',
  '24時間365日受付',
  '最短30分・即日対応',
  '侵入口の調査・封鎖を含む施工例',
  '施工箇所の永年保証制度',
];

const flowSteps = [
  { title: 'WEBから相談', body: '現在の症状や連絡先などを入力します。' },
  { title: '現地調査', body: '家の中・外周などを確認し、害獣の種類・被害状況・侵入口などを調査します。' },
  { title: '見積もり', body: '必要な対策と費用を確認します。' },
  { title: '内容に納得したら施工', body: '状況に応じて追い出しや侵入口対策等を実施します。' },
  { title: 'アフター対応', body: '施工内容・保証条件に応じて対応します。' },
];

const faqItems = [
  {
    q: '本当にネズミなのかわかりません',
    a: [
      '音だけでは別の害獣の可能性もあります。',
      'ハウスガード24は複数の害獣へ対応しているため、まず現地調査から相談できます。',
    ],
  },
  {
    q: '調査や見積もりは有料ですか？',
    a: [
      '公式サイトでは、お見積り・調査費0円と案内されています。',
      '最新条件は公式ページで確認してください。',
    ],
  },
  { q: '夜でも相談できますか？', a: ['公式サイトでは24時間365日対応と案内されています。'] },
  { q: '対応地域は？', a: ['東京都・千葉県・埼玉県・神奈川県・群馬県・茨城県・栃木県です。'] },
  {
    q: '一度対策したあと再発したら？',
    a: [
      '施工箇所について永年保証制度が案内されています。',
      '保証の適用条件や対象範囲は公式ページで確認してください。',
    ],
  },
];
---

<GaijuLp
  title="天井のカリカリ音はネズミ？侵入口から調べる害獣駆除の比較｜現地調査・見積もり0円"
  description="天井裏・壁の中・床下からのネズミらしい物音でお困りの方へ。今いる個体だけでなく侵入口まで確認できるかで害獣駆除サービスを比較しました。現地調査・見積もり0円、関東7県対応、24時間365日受付のハウスガード24を当サイト1位として紹介しています。"
  animal={ANIMAL}
  path="/gaiju/nezumi/"
  stickyLabel="無料で現地調査を相談する"
  stickyCaption="現地調査0円・お見積り0円／関東7県・24時間365日受付"
>
  <!-- ══ FV ══════════════════════════════════════════════ -->
  <section class="gj-hero" aria-labelledby="hero-heading">
    <p class="gj-hero-eyebrow">夜になると家の中から音がする方へ</p>
    <h1 id="hero-heading">
      <span class="gj-hero-line">天井から<em>「カリカリ…」</em></span>
      <span class="gj-hero-line">壁の中から<em>「ゴソゴソ…」</em></span>
    </h1>
    <p class="gj-hero-sub">家の中にネズミが入り込んでいるかもしれません。</p>
    <p>
      姿が見えなくても、天井裏・壁の中・床下など、普段見えない場所に入り込んでいることがあります。
    </p>
    <ul class="gj-hero-questions">
      <li>どこから入った？</li>
      <li>本当にネズミ？</li>
      <li>どこに頼めばいい？</li>
    </ul>
    <p>
      そんなときは、いきなり施工を決めるのではなく、<strong>まず現地で何が起きているか確認する</strong>という方法があります。
    </p>

    <div class="gj-rank1-box">
      <p class="gj-rank1-label">当サイトおすすめ1位</p>
      <p class="gj-rank1-name">ハウスガード24</p>
      <ul class="gj-check-bullets">
        {heroBullets.map((b) => <li>{b}</li>)}
      </ul>
      <Cta
        label="無料で現地調査を相談する"
        position="hero"
        animal={ANIMAL}
        note="※サービス内容・保証には条件があります。最新条件は公式サイトでご確認ください。"
      />
    </div>

    <ImagePlaceholder
      slotId="NEZUMI_HERO_01"
      purpose="住宅の天井裏・壁内にネズミが入り込んでいることが直感的に分かる安心感のある住宅断面イメージ"
    />
  </section>

  <!-- ══ 症状チェック ═════════════════════════════════════ -->
  <SymptomChecklist
    title="こんな症状、ありませんか？"
    lead="ひとつでも心当たりがあれば、家の見えない場所にネズミなどの害獣が入り込んでいる可能性を考えます。"
    items={symptoms}
  >
    <h3>大事なのは「姿を見たか」だけではありません</h3>
    <p>
      ネズミは人目につかない場所へ入り込むため、姿を見ていなくても、音・糞・かじられた跡などから気付くことがあります。
    </p>
    <p>「ネズミだと思うけど確信がない」という段階でも、現地調査で状況を確認できます。</p>
    <Cta label="今の症状をWEBから相談する" position="body" animal={ANIMAL} />
  </SymptomChecklist>

  <!-- ══ 問題提起 ═════════════════════════════════════════ -->
  <section class="gj-section" aria-labelledby="problem-heading">
    <h2 id="problem-heading">ネズミは「追い出せば終わり」とは限りません</h2>
    <p>ネズミ対策というと、</p>
    <ul class="gj-check-bullets">
      <li>粘着シート</li>
      <li>毒餌</li>
      <li>忌避剤</li>
    </ul>
    <p>などを思い浮かべる人も多いと思います。</p>
    <p>もちろん自分でできる対策もあります。</p>
    <p>ただし家の中への侵入が続いている場合、「今いるネズミ」だけでなく、</p>
    <p class="gj-emphasis">どこから家へ入り込んでいるのか</p>
    <p>まで確認しないと、また同じ場所から侵入する可能性があります。</p>

    <ImagePlaceholder
      slotId="NEZUMI_ENTRY_ROUTE_02"
      purpose="屋根・軒下・配管・基礎・壁の隙間等から屋内へ侵入する経路を示す図"
    />
  </section>

  <!-- ══ 自力対策 vs プロ ════════════════════════════════ -->
  <section class="gj-section gj-section--gray" aria-labelledby="diy-heading">
    <h2 id="diy-heading">自分で対策する場合と、業者へ相談する場合</h2>
    <div class="gj-two-col">
      <div class="gj-case-card">
        <h3>自分で対策しやすいケース</h3>
        <ul>
          <li>被害がごく軽い</li>
          <li>侵入口が自分で確認できる</li>
          <li>安全に作業できる範囲</li>
          <li>状況が明確</li>
        </ul>
      </div>
      <div class="gj-case-card gj-case-card--pro">
        <h3>一度プロへ相談したいケース</h3>
        <ul>
          <li>天井裏や壁の中など自分では確認しにくい</li>
          <li>どこから入っているかわからない</li>
          <li>一度対策しても再発している</li>
          <li>糞尿や臭いがある</li>
          <li>夜間の物音が続いている</li>
          <li>本当にネズミなのかわからない</li>
        </ul>
      </div>
    </div>

    <ImagePlaceholder
      slotId="NEZUMI_DIY_VS_PRO_03"
      purpose="「自分で対策」対「現地調査→侵入口確認→対策」の違いをシンプルに見せる図"
    />
  </section>

  <!-- ══ 比較の観点 ══════════════════════════════════════ -->
  <SelectionCriteria
    title="ネズミ駆除業者はこの8点で比較"
    items={criteria}
    summary="<strong>「今いる個体をどうするか」だけでなく、家への侵入原因まで確認しやすいか</strong>を重視します。"
  />

  <!-- ══ ランキング ══════════════════════════════════════ -->
  <RankingSection
    animal={ANIMAL}
    ctaLabel="ハウスガード24へWEB相談する"
    rank1Reason={{
      title: '今回の検索者と相性がいい理由',
      paragraphs: [
        '「天井から音がする」「壁の中に何かいる」「侵入口がわからない」という人にとって、最初から施工を決めるのではなく、現地調査・見積もりから相談できる点が使いやすいと評価しました。',
      ],
    }}
    rank1Points={rank1Points}
  >
    <div slot="rank1-extra" class="gj-guarantee">
      <h4>保証について</h4>
      <p>
        一度施工した箇所で再度害獣被害が発生した場合について、保証期間を設けず無償で再施工する永年保証制度が公式サイトで案内されています。
      </p>
      <p class="gj-note">※適用条件・対象範囲は必ず公式サイトで確認してください。</p>
    </div>
  </RankingSection>

  <!-- ══ 比較表 ══════════════════════════════════════════ -->
  <ComparisonTable animal={ANIMAL} ctaLabel="1位の詳細・無料相談を見る" />

  <!-- ══ 1位の詳細 ═══════════════════════════════════════ -->
  <section class="gj-section" aria-labelledby="rank1-detail-heading">
    <h2 id="rank1-detail-heading">ハウスガード24を詳しく見る</h2>

    <h3>まず状況確認から始められる</h3>
    <p>害獣トラブルで困るのが、「何がいるのかわからない」という状態です。</p>
    <p>
      ハウスガード24では、ネズミだけでなく、コウモリ・イタチ・ハクビシン・アライグマなどにも対応しています。
    </p>
    <p>
      そのため、音はするけれど動物の種類が判断できない場合でも、現地調査から相談しやすいのが特徴です。
    </p>

    <h3>侵入口まで確認</h3>
    <p>ネズミ施工例では、侵入口を調査し、穴を封鎖する対応が案内されています。</p>
    <p>一時的に追い出すだけでなく、再び入り込む経路への対策も業者選びでは確認したいポイントです。</p>

    <h3>調査・見積もり0円</h3>
    <p>実際の状態と必要な対策を確認してから、依頼するか検討できます。</p>

    <h3>関東7県</h3>
    <p>対応地域:</p>
    <ul class="gj-check-bullets">
      <li>東京都</li>
      <li>千葉県</li>
      <li>埼玉県</li>
      <li>神奈川県</li>
      <li>群馬県</li>
      <li>茨城県</li>
      <li>栃木県</li>
    </ul>

    <h3>24時間365日受付</h3>
    <p>夜になって物音に気付いた場合などにも、相談窓口が用意されています。</p>

    <Cta label="無料で現地調査を相談する" position="rank1" animal={ANIMAL} />
  </section>

  <!-- ══ 施工フロー ══════════════════════════════════════ -->
  <ServiceFlow steps={flowSteps}>
    <ImagePlaceholder
      slotId="NEZUMI_FLOW_04"
      purpose="WEB相談→現地調査→見積もり→施工→アフター対応の5ステップ図"
      ratio="16 / 9"
    />
  </ServiceFlow>

  <!-- ══ FAQ ═════════════════════════════════════════════ -->
  <Faq animal={ANIMAL} items={faqItems} ctaLabel="FAQを確認したうえでWEBから相談する" />

  <!-- ══ 最終CTA ═════════════════════════════════════════ -->
  <FinalCta
    animal={ANIMAL}
    headingLines={['天井の「カリカリ…」', '壁の中の「ゴソゴソ…」']}
    lead={['気になった状態のまま生活するより、まず何が起きているのか確認してみる。']}
    providerName="ハウスガード24"
    bullets={['現地調査 0円', 'お見積り 0円', '関東7県対応', '24時間365日受付']}
    ctaLabel="WEBから無料相談する"
  />
</GaijuLp>
